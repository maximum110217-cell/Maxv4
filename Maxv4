            if knife then
                if knife.Parent == LocalPlayer.Backpack then
                    knife.Parent = char
                end
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                        char.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame + Vector3.new(0, 1, 1.5)
                        task.wait(0.1)
                        if knife:FindFirstChild("Stab") then knife.Stab:FireServer() end
                        if knife:FindFirstChild("Slash") then knife.Slash:FireServer() end
                    end
                end
            end
        end
